{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperRenamer",
  "version": "0.1.1",
  "identifier": "com.caojiachen.paperrenamer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaperRenamer — 论文 PDF 重命名",
        "width": 1080,
        "height": 700,
        "minWidth": 860,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}